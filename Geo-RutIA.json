      "parameters": {
        "jsCode": "// Parsear el JSON del body\nconst pedidoData = JSON.parse($json.body);\n\n// Formatear mensaje para Telegram (como está)\nconst items = pedidoData.pedido.items\n  .map(item => `• ${item.name} - $${item.price.toLocaleString()}`)\n  .join('\\n');\n\nconst mensaje = `🌍 NUEVO PEDIDO DE LA GEOGRÁFICA 🌍\n\n👤 Cliente: ${pedidoData.cliente.nombre}\n📍 Dirección: ${pedidoData.cliente.direccion}\n\n🍽️ PEDIDO:\n${items}\n\n💰 Total: $${pedidoData.pedido.total.toLocaleString()}\n📦 Items: ${pedidoData.pedido.cantidad_items}\n\n🕐 Fecha: ${pedidoData.fecha_legible}\n\n¡Pedido recibido con coordenadas exactas! 🗺️`;\n\n// Generar ID único del pedido\nconst pedidoId = `GEO-${Date.now()}`;\n\nreturn [{\n  json: {\n    // Para Telegram\n    message: mensaje,\n    \n    // Para tabla CLIENTES (normalizado)\n    cliente_nombre: pedidoData.cliente.nombre,\n    cliente_direccion: pedidoData.cliente.direccion,\n    \n    // Para tabla PEDIDOS (normalizado)\n    pedido_id: pedidoId,\n    pedido_total: pedidoData.pedido.total,\n    pedido_cantidad_items: pedidoData.pedido.cantidad_items,\n    pedido_timestamp: pedidoData.timestamp,\n    pedido_fecha_legible: pedidoData.fecha_legible,\n    restaurant: \"La Geográfica\",\n    \n    // Para tabla ITEMS_PEDIDO (array)\n    pedido_items: pedidoData.pedido.items.map((item, index) => ({\n      pedido_id: pedidoId,\n      item_id: index + 1,\n      item_nombre: item.name,\n      item_precio: item.price\n    })),\n    \n    // Data original por si acaso\n    data_original: pedidoData\n  }\n}];"
      },
