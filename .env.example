# RutIA: copy to .env and change every "change-me" before running anything outside your machine.
#   cp .env.example .env

# Store (origin of every delivery)
EMPRESA_NOMBRE=RutIA Demo
EMPRESA_DIRECCION=Blanco Encalada 2680, CABA
EMPRESA_LAT=-34.5608
EMPRESA_LON=-58.4616

# H3
H3_RESOLUTION=9
H3_BUFFER_RADIUS=500

# PostgreSQL + PostGIS
POSTGRES_DB=rutia_db
POSTGRES_USER=rutia_admin
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://rutia_admin:change-me@postgres:5432/rutia_db
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
AIRFLOW__WEBSERVER__SECRET_KEY=change-me
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=change-me
AIRFLOW_API_URL=http://localhost:8080

# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_THEME_BASE=light

# API and webhooks
API_HOST=0.0.0.0
API_PORT=3000
N8N_WEBHOOK_URL=http://localhost:5678
WHATSAPP_API_URL=change-me

# OSM and routing
OSM_API_URL=https://overpass-api.de/api/interpreter
ROUTING_ENGINE=postgis
MAX_ROUTING_DISTANCE_KM=10

# Demo
DEMO_MODE=true
SIMULATE_RIDERS=true
AUTO_REFRESH_SECONDS=30
MAX_RIDERS=4
