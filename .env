# =============================================================================
# RutIA - Configuración Principal
# =============================================================================

# 🏪 EMPRESA CONFIGURACIÓN (Cambiar según ubicación)
EMPRESA_NOMBRE=RutIA Demo
EMPRESA_DIRECCION=Blanco Encalada 2680, CABA
EMPRESA_LAT=-34.56077965377718
EMPRESA_LON=-58.461592938922614

# 🔶 H3 CONFIGURACIÓN
H3_RESOLUTION=9
H3_BUFFER_RADIUS=500

# 🐳 DOCKER & SERVICES
POSTGRES_DB=rutia_db
POSTGRES_USER=rutia_admin
POSTGRES_PASSWORD=espacial123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 🌊 AIRFLOW
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://rutia_admin:espacial123@postgres:5432/rutia_db
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
AIRFLOW__WEBSERVER__SECRET_KEY=rutia_secret_key_2025

# 🌊 AIRFLOW ADMIN USER (AGREGADO)
# Airflow specific
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=espacial123
AIRFLOW_API_URL=http://localhost:8080

# 📱 STREAMLIT
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_THEME_BASE=light

# 🔗 APIs & WEBHOOKS
API_HOST=0.0.0.0
API_PORT=3000
N8N_WEBHOOK_URL=http://localhost:5678
WHATSAPP_API_URL=https://api.whatsapp.com

# 🗺️ OSM & ROUTING
OSM_API_URL=https://overpass-api.de/api/interpreter
ROUTING_ENGINE=postgis
MAX_ROUTING_DISTANCE_KM=10

# 🎯 DEMO CONFIG
DEMO_MODE=true
SIMULATE_RIDERS=true
AUTO_REFRESH_SECONDS=30
MAX_RIDERS=4